# Supabase — récupérés dans le dashboard du projet (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Emails (optionnel) — Resend. Si absent, aucun email n'est envoyé.
# Clé API : https://resend.com → API Keys
RESEND_API_KEY=
# Expéditeur. En mode test (sans domaine vérifié), garder onboarding@resend.dev
# (les emails ne partent qu'à l'adresse de TON compte Resend).
EMAIL_FROM=Tymios <onboarding@resend.dev>

# URL publique de l'app (pour les boutons dans les emails)
NEXT_PUBLIC_SITE_URL=

# Relances automatiques (optionnel) — route /api/relances déclenchée par Vercel Cron.
# Clé service Supabase (Settings → API → service_role) : NE JAMAIS exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=
# Secret partagé avec Vercel Cron (Vercel l'envoie en Bearer automatiquement).
CRON_SECRET=

# Copier ce fichier en `.env.local` et remplir les valeurs réelles.
# Ne JAMAIS committer `.env.local`.
